rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated (if you add authentication later)
    // function isAuthenticated() {
    //   return request.auth != null;
    // }
    
    // Users collection - anyone can read and write for now
    // Note: In production, you should restrict this to authenticated users only
    match /users/{userId} {
      // Allow read if the email matches the query
      allow read: if true;
      
      // Allow write (create, update) for any user
      // In production, restrict to: request.auth != null && request.auth.uid == userId
      allow write: if true;
      
      // Allow delete for any user
      // In production, restrict to: request.auth != null && request.auth.uid == userId
      allow delete: if true;
    }
    
    // Responders collection - anyone can read and write for now
    match /responders/{responderId} {
      allow read, write: if true;
    }
    
    // Ambulance drivers collection - read-only for clients
    match /ambulance_drivers/{driverId} {
      // Anyone can read ambulance driver info
      allow read: if true;
      
      // Only authenticated admins/drivers can write
      // For now, allow writes for testing
      allow write: if true;
    }
    
    // Hospitals collection - read-only for clients
    match /hospitals/{hospitalId} {
      // Anyone can read hospital info
      allow read: if true;
      
      // Only authenticated admins can write
      allow write: if true;
    }
    
    // Emergency alerts collection
    match /emergency_alerts/{alertId} {
      // Anyone can read and create alerts
      allow read, create: if true;
      
      // Only the creator can update/delete
      allow update, delete: if true;
    }
  }
}
